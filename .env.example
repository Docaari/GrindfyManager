# Database (PostgreSQL - Neon recommended for production)
DATABASE_URL=postgresql://user:password@localhost:5433/grindfy

# JWT Authentication (REQUIRED - server will not start without these)
JWT_SECRET=your-secure-jwt-secret-here
JWT_REFRESH_SECRET=your-secure-refresh-secret-here

# Server
PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3000

# SMTP Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-app-password-here
SMTP_FROM_NAME=Grindfy
SMTP_FROM_ADDRESS=your-email@example.com

# OAuth (optional)
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret

# Stripe (not yet integrated - future)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
