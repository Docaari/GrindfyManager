%% Sprint Spot-Anki-Reentry-3 — Feature flow: SRS grade button click
%% Cobre RF-3 (pagina /estudos/reentry) + RF-2 (algoritmo SM-2 + endpoint POST grade)
%% ADR-136 (algoritmo), ADR-137 (cap), ADR-139 (initial interval — nao aplica aqui, e on-create)
%% Lessons #21 (cache invalidator), #29 (ErrorBoundary se sub-arvore)

sequenceDiagram
    actor User as "Usuario (Pro)"
    participant ReentryPage as "Pagina /estudos/reentry<br/>(client)"
    participant API as "API Express<br/>POST /api/reentry/:cardId/grade"
    participant SrsService as "SpotReentry Service<br/>(applyGrade SM-2)"
    participant Storage as "storage.ts<br/>(Drizzle)"
    participant DB as "PostgreSQL<br/>spot_reentry_cards"
    participant Cache as "stats cache (Map TTL 5min)"
    participant TQClient as "TanStack Query client cache"

    User->>ReentryPage: "Clica botao 'good' (ou tecla 3/Enter)"
    ReentryPage->>ReentryPage: "Valida grade in {again,hard,good,easy}"
    ReentryPage->>API: "POST /api/reentry/:cardId/grade<br/>Body: { grade: 'good' }<br/>Header: X-Idempotency-Key (opcional)"

    API->>API: "requireAuth (JWT)"
    API->>Storage: "getReentryCard(cardId)"
    Storage->>DB: "SELECT * WHERE id=:cardId AND user_id=:userId AND archived_at IS NULL"
    DB-->>Storage: "card row OR null"

    alt card not found OR archived
        Storage-->>API: "null"
        API-->>ReentryPage: "404 OR 410 Gone"
        ReentryPage->>User: "Toast info + skip card<br/>(race condition mitigation)"
    else card found
        Storage-->>API: "{ card }"
        API->>SrsService: "applyGrade(card, 'good')"

        SrsService->>SrsService: "switch grade:<br/>- again: interval=1, ease *= 0.8 (cap 1.3)<br/>- hard: interval *= 1.2, ease *= 0.9<br/>- good: interval *= ease<br/>- easy: interval *= ease * 1.3, ease *= 1.15 (cap 3.0)"
        SrsService->>SrsService: "Cap interval [1, 120], round 2 decimal<br/>nextReviewAt = now() + interval * 86400 ms"
        SrsService-->>API: "{ nextIntervalDays, newEaseFactor, nextReviewAt }"

        API->>Storage: "updateReentryCard(cardId, {<br/>  interval_days, ease_factor,<br/>  next_review_at, review_count++,<br/>  correct_count++ if grade != 'again',<br/>  last_review_at=NOW(),<br/>  last_grade='good'<br/>})"
        Storage->>DB: "UPDATE spot_reentry_cards SET ... WHERE id=:cardId"
        DB-->>Storage: "1 row updated"
        Storage-->>API: "updated card"

        API->>Cache: "invalidateStatsCache(userId)<br/>(lesson #21)"
        Cache-->>API: "invalidated"

        API->>Storage: "getNextPendingCard(userId)<br/>(SELECT 1 WHERE next_review_at <= NOW() AND archived_at IS NULL ORDER BY next_review_at LIMIT 1)"
        Storage->>DB: "query"
        DB-->>Storage: "next card OR null"
        Storage-->>API: "nextCard"

        API-->>ReentryPage: "200 { card: updated, nextReviewAt, intervalDays, nextCard }"

        ReentryPage->>TQClient: "invalidate ['/api/reentry/queue', '/api/reentry/stats']"
        ReentryPage->>ReentryPage: "Framer Motion: slide-out left 250ms"
        ReentryPage->>ReentryPage: "currentIndex++"

        alt currentIndex >= cards.length
            ReentryPage->>ReentryPage: "stage='done', confetti CSS"
            ReentryPage->>User: "'Sessao finalizada! Acertou 4/5 (80%)'"
        else has more cards
            ReentryPage->>ReentryPage: "Render proximo card<br/>(slide-in right 250ms)"
            ReentryPage->>User: "Toast (1.5s top-right): 'Proximo: 2.5d'"
        end
    end

    Note over Cache: TTL 5min<br/>Invalidator publico chamado por mutations (lesson #21)<br/>_resetForTests() usado em beforeEach
