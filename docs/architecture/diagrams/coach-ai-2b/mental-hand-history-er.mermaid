%% AI-2B (ADR-171) — Mental Hand History (framework Tendler) ERD.
%% Tabela dedicada (Q-E lock: queryability por emoção/tempo indexáveis).
%% Tool log_mental_hand write/confirm Pro+/Trial; endpoints HTTP POST/GET/DELETE abertos (free pode via form).
%% Quarterly Report consome top 3 via selectTopHighlights por intensidade/recência + diversidade emoção.

erDiagram
    users ||--o{ mental_hand_history : "ON DELETE CASCADE"
    grind_sessions ||--o{ mental_hand_history : "ON DELETE SET NULL"
    mental_hand_history ||--o{ coach_actions : "audit log via persist"

    users {
        varchar user_platform_id PK "USER-XXXX"
        varchar email
        varchar first_name
        varchar subscription_plan "trial|active|expired|admin (free derived)"
        varchar country "BR|US|... (Quarterly IRPF gate)"
        timestamp created_at
    }

    grind_sessions {
        varchar id PK "nanoid"
        varchar user_id FK
        timestamp date
        varchar status "planned|active|completed"
        numeric profit_loss
        integer duration_minutes
    }

    mental_hand_history {
        varchar id PK "nanoid (21 chars)"
        varchar user_id FK "ON DELETE CASCADE"
        timestamp occurred_at "user-reported snapshot — quando aconteceu"
        text situation "max 1000 — BB 30 vs UTG opener 22"
        varchar emotion "CHECK enum: frustration|tilt|fear|overconfidence|fatigue|other (nullable)"
        text real_response "max 1000 — o que realmente fez"
        text ideal_response "max 1000 — o que deveria ter feito"
        text_array tags "array livre, sem GIN no MVP"
        varchar linked_grind_session_id FK "nullable, ON DELETE SET NULL — mental hand sobrevive ao tracking"
        timestamp created_at "DEFAULT NOW"
    }

    coach_actions {
        varchar id PK
        varchar user_id FK
        varchar tool_name "log_mental_hand"
        varchar status "pending|completed|undone"
        jsonb input
        jsonb payload_after "{createdId} para undo"
        timestamp confirmed_at
        timestamp undo_expires_at "NOW + 30min"
    }

    user_coach_preferences {
        varchar user_id PK
        boolean report_quarterly_enabled "AI-2B opt-in conteúdo Quarterly"
        boolean email_quarterly_enabled "AI-2B opt-in canal email Quarterly (ADR-172)"
        timestamp disclaimer_accepted_at "AI-2B ADR-173"
    }

    %% Indexes:
    %%   idx_mental_hh_user_occurred — (user_id, occurred_at DESC) — viewer paginado por tempo
    %%   idx_mental_hh_user_emotion — (user_id, emotion) — filtro por emoção
    %%
    %% Consumers:
    %%   - Tool log_mental_hand (ADR-171 §2.2) — INSERT via coachToolRunner (confirm/undo)
    %%   - Endpoint GET /api/coach/mental-hands?limit=20&offset=0&emotion= — viewer paginado
    %%   - Endpoint POST /api/coach/mental-hands — UI form (Free+, rate limit 20/dia)
    %%   - Endpoint DELETE /api/coach/mental-hands/:id — ownership check via 404
    %%   - quarterlyReportGenerator.ts — selectTopHighlights(rituals, 3) → mentalHandHighlights em ReportContent v3
    %%
    %% Privacidade:
    %%   - Texto livre sensível — nunca para 3rd parties EXCETO Anthropic via Quarterly Report context (top 3 only, não tudo)
    %%   - DELETE pelo user permitido (ownership check via 404 not 403 — não leakar existência)
