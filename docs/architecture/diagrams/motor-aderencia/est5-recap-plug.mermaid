flowchart TD
    A["weeklyReviewMondayTick / POST .../start<br/>createWeeklyReview(userId, weekStartDate)<br/>L220 weeklyReviewOrchestrator.ts"] --> B["prevWeekPeriod(weekStartDate)<br/>L90 → { periodStart, periodEnd } (segunda anterior, UTC)"]
