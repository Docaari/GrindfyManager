    C --> D["buildRecap(RecapInput)<br/>L179 buildRecap.ts — PURO, determinístico, sem LLM"]

    subgraph NEW["NOVO — RF-08 (motor pluga AQUI)"]
        E["buildAdherenceRecap(userId, prevWeekStartDate, injectedStorage)<br/>server/coach/adherence/recap.ts"]
        E --> F["getPlannedVsActual(grind_sessions_count)<br/>getPlannedVsActual(study_minutes)"]
