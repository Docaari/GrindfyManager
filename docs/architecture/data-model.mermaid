erDiagram
    %% ===== DOMINIO: AUTH & USERS =====

    users {
        varchar id PK "nanoid"
        varchar user_platform_id UK "USER-XXXX sequencial"
        varchar email UK "not null"
        varchar first_name "nullable"
        varchar last_name "nullable"
        varchar name "nullable, full name"
        varchar password "bcrypt hash"
        varchar username UK "nullable"
        varchar role "default: user (admin/user/moderator)"
        varchar status "default: pending_verification"
        varchar subscription_plan "default: basico"
        varchar timezone "default: America/Sao_Paulo"
        varchar currency "default: BRL"
        boolean email_verified "default: false"
        varchar email_verification_token "nullable"
        varchar password_reset_token "nullable"
        timestamp password_reset_expires "nullable"
        integer failed_login_attempts "default: 0"
        timestamp locked_until "nullable"
        varchar google_id "nullable, OAuth"
        timestamp created_at "defaultNow"
        timestamp last_login "nullable"
    }

    sessions {
        varchar sid PK "express-session"
        jsonb sess "not null"
        timestamp expire "not null, indexed"
    }

    permissions {
        varchar id PK "nanoid"
        varchar name UK "not null"
        varchar description "nullable"
        timestamp created_at "defaultNow"
    }

    user_permissions {
        varchar id PK "nanoid"
        varchar user_id FK "references users.user_platform_id"
        varchar permission_id FK "references permissions.id"
        boolean granted "default: true"
        varchar status "default: active"
        timestamp expiration_date "nullable"
        varchar subscription_plan "nullable"
        boolean auto_renew "default: false"
    }

    access_logs {
        varchar id PK "nanoid"
        varchar user_id FK "references users.user_platform_id, nullable"
        varchar permission_name "nullable"
        varchar action "login_success/failed/access_denied/granted"
        varchar ip_address "nullable"
        varchar user_agent "nullable"
        jsonb metadata "nullable"
        timestamp created_at "defaultNow"
    }

    users ||--o{ user_permissions : "tem permissoes"
    permissions ||--o{ user_permissions : "atribuida a usuarios"
    users ||--o{ access_logs : "gera logs de acesso"

    %% ===== DOMINIO: SUBSCRIPTIONS =====

    subscriptions {
        varchar id PK "nanoid"
        varchar user_id FK "references users.user_platform_id"
        varchar plan_type "basic/premium/pro"
        varchar status "default: active"
        timestamp start_date "defaultNow"
        timestamp end_date "not null"
        integer duration_days "not null (30/90/365)"
        boolean auto_renewal "default: false"
        varchar payment_status "default: pending"
        varchar stripe_subscription_id "nullable, futuro"
    }

    subscription_plans {
        varchar id PK "nanoid"
        varchar name "not null (Basico/Premium/Pro)"
        text description "nullable"
        text[] permissions "array of permission IDs"
        integer duration_days "default: 30"
        decimal price "precision 10,2"
        varchar currency "default: USD"
        boolean is_active "default: true"
        text[] features "array"
    }

    user_subscriptions {
        varchar id PK "nanoid"
        varchar user_id FK "references users.id"
        varchar plan_id FK "references subscription_plans.id"
        varchar status "default: active"
        timestamp start_date "defaultNow"
        timestamp end_date "nullable"
        boolean auto_renew "default: false"
        varchar payment_method "nullable (stripe/manual)"
        varchar payment_id "nullable"
        jsonb metadata "nullable"
    }

    users ||--o{ subscriptions : "tem assinaturas"
    subscription_plans ||--o{ user_subscriptions : "plano escolhido"
    users ||--o{ user_subscriptions : "assina planos"

    %% ===== DOMINIO: TOURNAMENTS =====

    tournaments {
        varchar id PK "nanoid"
        varchar user_id FK "references users.user_platform_id"
        varchar tournament_id "nullable, ID externo poker site"
        varchar name "not null"
        decimal buy_in "not null"
        decimal prize_pool "nullable"
        integer position "nullable"
        decimal prize "default: 0"
        timestamp date_played "not null"
        varchar site "not null (PokerStars/GGPoker/etc)"
        varchar format "not null (MTT/SNG)"
        varchar category "DEPRECATED Sprint 5 ADR-032 — espelhada de type Sprint 1-4"
        varchar type "NOT NULL ADR-031 — Vanilla/PKO/Mystery/Satellite (enum mutex)"
        varchar speed "not null (Regular/Turbo/Hyper)"
        integer field_size "nullable"
        integer reentries "default: 0 NOT NULL — pre-existente"
        boolean final_table "default: false"
        boolean big_hit "default: false"
        varchar currency "default: BRL"
        decimal rake "default: 0"
        varchar template_id FK "nullable references tournament_templates.id"
        varchar grind_session_id FK "nullable"
        boolean allows_addon "default: false NOT NULL — ADR-014"
        decimal addon_cost "nullable — so se allows_addon=true — ADR-014"
        boolean addon_taken "default: false NOT NULL — ADR-014"
        boolean allows_reentry "default: false NOT NULL — ADR-014"
        integer max_reentries "nullable (null=ilimitado) — ADR-014"
        boolean is_flight "default: false NOT NULL — ADR-031 modificador ortogonal"
        boolean is_live "default: false NOT NULL — ADR-031 modificador ortogonal"
        varchar satellite_reward_type "nullable ADR-031 — ticket/package/cash/mixed"
        decimal satellite_ticket_value "nullable USD — quando rewardType=ticket ou mixed"
        varchar satellite_target_template_id FK "nullable references tournament_templates.id (FK soft)"
        varchar satellite_target_name "nullable — fallback texto livre"
        decimal satellite_extra_cash "nullable USD — premio cash extra (hibrido)"
        boolean entered_via_satellite "default: false NOT NULL — flag para ROI agregado"
        varchar flight_day "nullable — 1A/1B/Final/Day 2 regex validado"
        varchar flight_parent_id FK "nullable references tournaments.id (self-FK soft)"
        boolean flight_advanced "nullable — true=avancou, false=eliminado, null se Day Final"
        decimal package_buy_in "nullable USD — componente buy-in do pacote (live)"
        decimal package_accommodation "nullable USD — hospedagem"
        decimal package_travel "nullable USD — voo/transporte"
        decimal package_meals "nullable USD — alimentacao"
        decimal package_other "nullable USD — outras despesas"
        text package_notes "nullable — observacoes livres"
        boolean added_manually "default: false NOT NULL — distingue manual vs CSV ADR-031 D13"
    }

    tournament_templates {
        varchar id PK "nanoid"
        varchar user_id FK "not null"
        varchar name "not null"
        varchar site "not null"
        varchar format "not null"
        varchar category "not null"
        varchar speed "not null"
        jsonb day_of_week "number[]"
        jsonb start_time "string[]"
        decimal avg_buyin "default: 0"
        decimal avg_roi "default: 0"
        integer total_played "default: 0"
        decimal total_profit "default: 0"
        integer final_tables "default: 0"
        integer big_hits "default: 0"
        integer avg_field_size "nullable"
    }

    upload_history {
        varchar id PK "nanoid"
        varchar user_id FK "references users.id"
        varchar filename "not null"
        varchar status "success/error/processing"
        integer tournaments_count "default: 0"
        text error_message "nullable"
        integer duplicates_found "default: 0"
        varchar duplicate_action "nullable"
        timestamp upload_date "defaultNow"
    }

    users ||--o{ tournaments : "importa torneios"
    users ||--o{ tournament_templates : "possui templates"
    users ||--o{ upload_history : "realiza uploads"
    tournament_templates ||--o{ tournaments : "origina torneios"
    tournament_templates ||--o{ tournaments : "satellite_target_template_id (FK soft ADR-031)"
    tournaments ||--o{ tournaments : "flight_parent_id self-FK soft (re-entry 1A/1B/Day Final)"

    %% ===== ADR-031 Tournament Types Orthogonal Model =====
    %%
    %% Indices em tournaments (Sprint 1):
    %%   IDX (user_id, satellite_target_template_id) PARTIAL WHERE satellite_target_template_id IS NOT NULL
    %%     idx_tournaments_user_satellite_target — alvo de getSatelliteROI (RF-04)
    %%   IDX (user_id, flight_parent_id) PARTIAL WHERE flight_parent_id IS NOT NULL
    %%     idx_tournaments_user_flight_parent — alvo de getFlightAggregateROI (RF-05)
    %%   IDX (user_id, category, date_played)
    %%     idx_tournaments_user_type_date — substitui scans de category groupBy (Sprint 1-4 espelhado)
    %%     Sprint 5: renomear para (user_id, type, date_played) apos drop de category (ADR-032)
    %%   IDX (user_id, is_live) PARTIAL WHERE is_live = true
    %%     idx_tournaments_user_is_live — alvo de /api/analytics/by-modifier
    %%   IDX (user_id, is_flight) PARTIAL WHERE is_flight = true
    %%     idx_tournaments_user_is_flight — alvo de /api/analytics/by-modifier
    %%
    %% Invariantes (ADR-031 + ADR-032 — Sprint 1-4):
    %%   tournaments.type ∈ {Vanilla, PKO, Mystery, Satellite} (enum estrito server-side)
    %%   tournaments.category == tournaments.type (espelhada via normalizeTournamentTypePayload)
    %%   if type='Satellite' AND prize > 0:
    %%     satelliteRewardType ∈ {ticket, package, cash, mixed} obrigatorio
    %%     (target_template_id OR target_name) obrigatorio
    %%     conforme rewardType: ticketValue OU pelo menos um package_* OU extraCash
    %%   if type != 'Satellite': todos satellite_* devem ser null
    %%   if isFlight=true: flightDay regex `^(Final|Day\s?\d+|\d+[A-Z]?)$` obrigatorio
    %%     se flightDay matcha `\d+[A-Z]` (Day 1): flightAdvanced obrigatorio, prize=0, position=null
    %%     se flightDay='Final' ou Day 2+: position+prize obrigatorios, flightAdvanced=null
    %%   if isFlight=false: todos flight_* devem ser null
    %%   if isLive=true: package_* todos opcionais
    %%   if isLive=false: todos package_* devem ser null
    %%   Mutual exclusion: type='Satellite' AND rewardType='package' AND isLive=true => ZodError
    %%
    %% Sprint 5 (ADR-032):
    %%   ALTER TABLE tournaments DROP COLUMN category
    %%   ALTER TABLE planned_tournaments DROP COLUMN category
    %%   Helper normalizeTournamentTypePayload removido

    %% ===== DOMINIO: GRIND SESSIONS =====

    grind_sessions {
        varchar id PK "nanoid"
        varchar user_id FK "not null"
        timestamp date "not null"
        decimal planned_buyins "default: 0"
        decimal actual_buyins "default: 0"
        decimal profit_loss "default: 0"
        integer duration "nullable, minutos"
        timestamp start_time "nullable"
        timestamp end_time "nullable"
        varchar status "planned/active/completed/cancelled"
        integer tournaments_played "default: 0"
        integer final_tables "default: 0"
        text notes "nullable"
        text preparation_notes "nullable"
        integer preparation_percentage "0-100"
        text daily_goals "nullable"
        integer screen_cap "nullable"
        jsonb session_snapshot "nullable"
        decimal energia_media "nullable"
        decimal foco_medio "nullable"
        decimal confianca_media "nullable"
    }

    session_tournaments {
        varchar id PK "nanoid"
        varchar user_id FK "not null"
        varchar session_id FK "not null"
        varchar site "not null"
        text name "nullable"
        varchar time "nullable (ex: 19h00)"
        decimal buy_in "not null"
        decimal guaranteed "nullable"
        integer rebuys "default: 0"
        decimal result "default: 0"
        integer position "nullable"
        decimal bounty "default: 0"
        decimal prize "default: 0"
        varchar status "upcoming/registered/active/finished"
        varchar type "default: Vanilla"
        varchar speed "default: Normal"
        integer prioridade "1-Alta/2-Media/3-Baixa"
        varchar planned_tournament_id FK "nullable"
        integer late_reg_minutes "nullable — minutos de late registration (Suprema)"
        integer starting_stack "nullable — stack inicial (Suprema)"
        integer max_players "nullable — max jogadores (Suprema)"
        varchar game_type "nullable — NLH ou PLO (Suprema)"
        integer blind_level_minutes "nullable — duracao nivel de blind (Suprema)"
        integer alert_minutes_before "nullable — override alerta por torneio"
        boolean allows_addon "default: false NOT NULL — ADR-014 (copy-on-promote de planned)"
        decimal addon_cost "nullable — so se allows_addon=true — ADR-014"
        boolean addon_taken "default: false NOT NULL — ADR-014 (instancia de jogo)"
        boolean allows_reentry "default: false NOT NULL — ADR-014"
        integer max_reentries "nullable (null=ilimitado) — ADR-014"
        integer reentries "default: 0 NOT NULL — ADR-014 (instancia de jogo)"
    }

    break_feedbacks {
        varchar id PK "nanoid"
        varchar user_id FK "not null"
        varchar session_id FK "nullable"
        timestamp break_time "not null"
        integer foco "0-10"
        integer energia "0-10"
        integer confianca "0-10"
        integer inteligencia_emocional "0-10"
        integer interferencias "0-10"
        text notes "nullable"
    }

    preparation_logs {
        varchar id PK "nanoid"
        varchar user_id FK "not null"
        varchar session_id FK "nullable"
        integer mental_state "not null"
        integer focus_level "not null"
        integer confidence_level "not null"
        jsonb exercises_completed "string[]"
        boolean warmup_completed "default: false"
        text session_goals "nullable"
        text post_session_review "nullable"
        boolean goals_achieved "nullable"
    }

    %% DEPRECATED 60d - ADR-029
    %% preparation_logs permanece intacta porem read-only para codigo novo
    %% Codigo novo (Sprint W-1) escreve EXCLUSIVAMENTE em warmup_rituals
    %% Drop planejado em sprint posterior se telemetria confirmar zero leitura

    warmup_rituals {
        varchar id PK "nanoid - Sprint W-1 (ADR-028)"
        varchar user_id FK "references users.user_platform_id ON DELETE CASCADE, NOT NULL"
        timestamp started_at "NOT NULL - quando o ritual comecou"
        timestamp completed_at "nullable - null se aborted antes do fim"
        integer duration_minutes "nullable - calculado quando completedAt presente"
        varchar version "NOT NULL varchar(16) - full|aborted (W-3 adiciona minimal)"
        integer emotional_check_score "nullable, 0-10, null se aborted antes do bloco 1"
        boolean decision_to_play "nullable - null=aborted; true=jogou; false=nao jogou"
        boolean override_used "default: false NOT NULL - true se score<6 mas decidiu jogar (ADR-027)"
        jsonb blocks_completed "default [] - array WarmupBlockSnapshot por bloco"
        jsonb session_intention "nullable - {focus, tiltPlan, stopCriteria}"
        varchar linked_grind_session_id FK "nullable - FK opcional para grind_sessions.id (ON DELETE SET NULL)"
        timestamp created_at "defaultNow"
    }

    users ||--o{ warmup_rituals : "executa rituais de warm-up (Sprint W-1)"
    grind_sessions ||--o| warmup_rituals : "FK opcional via linkedGrindSessionId (correlacao com performance)"

    %% Indices em warmup_rituals (Sprint W-1):
    %%   IDX (user_id, completed_at) - idx_warmup_rituals_user_completed
    %%     alvo da query do gate: WHERE user_id=? AND version='full' AND completed_at > now()-30min
    %%   IDX (user_id, started_at) - idx_warmup_rituals_user_started
    %%     alvo da query de historico: ORDER BY started_at DESC paginado
    %%
    %% Regras derivadas (ADR-027 + ADR-028):
    %%   version='full' requer: emotional_check_score, decision_to_play, session_intention NAO-NULL
    %%   version='aborted' aceita campos nullable
    %%   override_used=true exige: emotional_check_score < 6 AND decision_to_play=true (validacao cross-field server-side)
    %%   blocks_completed e snapshot final por bloco (1..5); cada item: {blockId, startedAt, completedAt, durationSeconds, ...campos especificos}
    %%   session_intention: {focus: string<=200, tiltPlan: string<=200, stopCriteria: string<=200}
    %%
    %% Telemetria (ADR-030): client-only nesta sprint via console.log
    %%   Eventos materialmente importantes (gate_triggered, override_used, warmup_completed/aborted)
    %%   tem espelho em colunas desta tabela - queries SQL geram metricas-chave

    users ||--o{ grind_sessions : "cria sessoes"
    grind_sessions ||--o{ session_tournaments : "contem torneios em tempo real"
    grind_sessions ||--o{ break_feedbacks : "registra feedbacks de break"
    grind_sessions ||--o{ preparation_logs : "registra preparacao"
    grind_sessions ||--o{ tournaments : "vincula historico"

    %% ===== DOMINIO: GRADE & PLANEJAMENTO =====

    weekly_plans {
        varchar id PK "nanoid"
        varchar user_id FK "not null"
        timestamp week_start "not null"
        varchar title "nullable"
        text description "nullable"
        decimal target_buyins "nullable"
        decimal target_profit "nullable"
        integer target_volume "nullable"
        boolean is_active "default: true"
    }

    planned_tournaments {
        varchar id PK "nanoid"
        varchar user_id FK "not null"
        integer day_of_week "not null (0=Dom, 6=Sab)"
        varchar profile "default: A (A/B/C)"
        varchar site "not null"
        varchar time "not null (ex: 19h00)"
        varchar type "NOT NULL ADR-031 — Vanilla/PKO/Mystery/Satellite (enum mutex)"
        varchar category "DEPRECATED Sprint 5 ADR-032 — espelhada de type Sprint 1-4"
        varchar speed "not null (Normal/Turbo/Hyper)"
        text name "not null"
        decimal buy_in "not null"
        decimal guaranteed "nullable"
        varchar template_id FK "nullable"
        varchar status "default: upcoming"
        integer prioridade "1-Alta/2-Media/3-Baixa"
        varchar session_id FK "nullable"
        integer late_reg_minutes "nullable — minutos de late registration (Suprema)"
        integer starting_stack "nullable — stack inicial (Suprema)"
        integer max_players "nullable — max jogadores (Suprema)"
        varchar game_type "nullable — NLH ou PLO (Suprema)"
        integer blind_level_minutes "nullable — duracao nivel de blind (Suprema)"
        integer alert_minutes_before "nullable — override alerta por torneio"
        boolean allows_addon "default: false NOT NULL — ADR-014"
        decimal addon_cost "nullable — so se allows_addon=true — ADR-014"
        boolean allows_reentry "default: false NOT NULL — ADR-014"
        integer max_reentries "nullable (null=ilimitado) — ADR-014"
        boolean is_flight "default: false NOT NULL — ADR-031"
        boolean is_live "default: false NOT NULL — ADR-031"
        varchar satellite_reward_type "nullable ADR-031 — ticket/package/cash/mixed"
        varchar satellite_target_template_id FK "nullable references tournament_templates.id (FK soft)"
        varchar satellite_target_name "nullable — fallback texto livre"
        varchar flight_day "nullable — 1A/1B/Final regex validado"
        varchar flight_parent_id FK "nullable references tournaments.id (self-FK soft)"
    }

    active_days {
        varchar id PK "nanoid"
        varchar user_id FK "not null"
        integer day_of_week "0-6"
        boolean is_active "default: true"
    }

    profile_states {
        varchar id PK "nanoid"
        varchar user_id FK "references users.user_platform_id"
        integer day_of_week "0-6"
        varchar active_profile "A/B/C/OFF (default OFF) — ADR-010"
    }

    tournament_library {
        varchar id PK "nanoid — ADR-009"
        varchar user_id FK "references users.user_platform_id, not null"
        text name "not null"
        varchar site "not null"
        decimal buy_in "not null"
        decimal guaranteed "nullable"
        varchar time "nullable HH:mm"
        varchar type "nullable PKO/Vanilla/Mystery"
        varchar speed "nullable Normal/Turbo/Hyper"
        integer field_size "nullable"
        varchar source "not null default manual (manual/suprema/grind-live)"
        varchar external_id "nullable unique per user — ADR-012"
        timestamp deleted_at "nullable (lixeira soft delete)"
        timestamp created_at "defaultNow"
        timestamp updated_at "defaultNow"
        boolean allows_addon "default: false NOT NULL — ADR-014"
        decimal addon_cost "nullable — so se allows_addon=true — ADR-014"
        boolean allows_reentry "default: false NOT NULL — ADR-014"
        integer max_reentries "nullable (null=ilimitado) — ADR-014"
    }

    tournament_library_settings {
        varchar id PK "nanoid"
        varchar user_id FK "unique, 1 por usuario"
        boolean auto_import_suprema "default false"
        timestamp last_suprema_sync "nullable"
        varchar last_suprema_sync_status "nullable success/error"
        timestamp created_at "defaultNow"
    }

    users ||--o{ weekly_plans : "cria planos semanais"
    users ||--o{ planned_tournaments : "planeja torneios"
    users ||--o{ active_days : "define dias ativos"
    users ||--o{ tournament_library : "catalogo pessoal editavel"
    users ||--|| tournament_library_settings : "config importacao (1:1)"
    users ||--o{ profile_states : "define perfis por dia"
    tournament_templates ||--o{ planned_tournaments : "baseado em template"
    tournament_templates ||--o{ planned_tournaments : "satellite_target_template_id (FK soft ADR-031)"
    planned_tournaments ||--o{ session_tournaments : "migra para sessao ativa"

    %% ===== DOMINIO: ESTUDOS =====

    study_cards {
        varchar id PK "nanoid"
        varchar user_id FK "not null"
        varchar title "not null"
        varchar category "not null (3bet/ICM/etc)"
        varchar priority "Critico/Alto/Medio/Baixo"
        text description "nullable"
        decimal current_stat "nullable"
        decimal target_stat "nullable"
        integer knowledge_score "0-100"
        integer time_invested "minutos"
        varchar status "active/completed/paused"
        jsonb study_days "string[]"
        integer study_duration "minutos"
    }

    study_materials {
        varchar id PK "nanoid"
        varchar study_card_id FK "not null"
        varchar title "not null"
        varchar type "video/article/pdf/file"
        varchar url "nullable"
        varchar status "not_viewed/viewed/completed"
        integer time_spent "minutos"
    }

    study_notes {
        varchar id PK "nanoid"
        varchar study_card_id FK "not null"
        varchar title "nullable"
        text content "not null"
        jsonb tags "string[]"
    }

    study_sessions {
        varchar id PK "nanoid"
        varchar user_id FK "not null"
        varchar study_card_id FK "nullable"
        timestamp date "not null"
        integer duration "not null, minutos"
        jsonb activities "string[]"
        integer focus_score "0-10"
        integer productivity_score "0-10"
        text insights "nullable"
    }

    study_schedules {
        varchar id PK "nanoid"
        varchar user_id FK "not null"
        varchar study_card_id FK "not null"
        integer day_of_week "0-6"
        varchar start_time "not null"
        integer duration "minutos"
        boolean is_recurring "default: false"
    }

    users ||--o{ study_cards : "cria cards de estudo"
    study_cards ||--o{ study_materials : "contem materiais"
    study_cards ||--o{ study_notes : "contem notas"
    study_cards ||--o{ study_sessions : "gera sessoes"
    study_cards ||--o{ study_schedules : "tem agendamentos"
    users ||--o{ study_sessions : "realiza sessoes"

    %% ===== DOMINIO: CALENDARIO =====

    calendar_categories {
        varchar id PK "nanoid"
        varchar user_id FK "not null"
        varchar name "not null"
        varchar color "not null, hex"
        varchar icon "nullable, lucide icon"
        boolean is_default "default: false"
    }

    calendar_events {
        varchar id PK "nanoid"
        varchar user_id FK "not null"
        varchar category_id FK "not null"
        varchar title "not null"
        text description "nullable"
        timestamp start_time "not null"
        timestamp end_time "not null"
        integer day_of_week "0-6"
        varchar recurrence_type "none/daily/weekly"
        jsonb recurrence_pattern "nullable"
        varchar parent_event_id FK "nullable, self-ref"
        boolean is_recurring "default: false"
        varchar source "manual/grade/studies"
    }

    weekly_routines {
        varchar id PK "nanoid"
        varchar user_id FK "not null"
        timestamp week_start "not null"
        jsonb blocks "not null, default []"
        jsonb conflicts "not null, default []"
        boolean is_auto_generated "default: true"
    }

    users ||--o{ calendar_categories : "cria categorias"
    calendar_categories ||--o{ calendar_events : "categoriza eventos"
    users ||--o{ calendar_events : "cria eventos"
    calendar_events ||--o{ calendar_events : "evento pai gera filhos"
    users ||--o{ weekly_routines : "gera rotinas"

    %% ===== DOMINIO: ADMIN & SISTEMA =====

    user_settings {
        varchar id PK "nanoid"
        varchar user_id UK "not null"
        decimal big_hit_multiplier "default: 10"
        boolean email_notifications "default: true"
        boolean coaching_alerts "default: true"
        varchar preferred_currency "default: BRL"
        boolean dark_mode "default: false"
        jsonb exchange_rates "Record string number"
        integer late_reg_alert_minutes "default: 10 — minutos antes do deadline para alerta"
        boolean late_reg_alert_enabled "default: true — master switch alertas"
        boolean late_reg_alert_sound "default: true — habilitar som no alerta"
        integer grade_start_hour "default: 12 — 0-23 (NOVO — Biblioteca v2)"
        integer grade_end_hour "default: 3 — 0-23 wrap midnight (NOVO — Biblioteca v2)"
        jsonb weekly_heuristics "nullable - tuple[3] strings max 280 chars cada (Sprint W-1, RF-22)"
        varchar drill_url "default: https://app.gtowizard.com/ - link configuravel Bloco 3 (Sprint W-1)"
    }

    notifications {
        varchar id PK "nanoid"
        varchar user_id FK "references users.user_platform_id"
        varchar type "subscription_expiring/expired/general"
        varchar title "not null"
        text message "not null"
        varchar priority "low/medium/high"
        boolean read "default: false"
    }

    bug_reports {
        varchar id PK "nanoid"
        varchar user_id FK "references users.user_platform_id"
        varchar page "not null"
        text description "not null"
        varchar urgency "default: medium"
        varchar type "bug/suggestion/performance"
        varchar status "open/in_progress/resolved/dismissed"
        text admin_notes "nullable"
    }

    custom_groups {
        varchar id PK "nanoid"
        varchar user_id FK "not null"
        varchar name "not null"
        varchar color "nullable"
        jsonb criteria "not null"
    }

    custom_group_templates {
        varchar id PK "nanoid"
        varchar group_id FK "not null"
        varchar template_id FK "not null"
    }

    coaching_insights {
        varchar id PK "nanoid"
        varchar user_id FK "not null"
        varchar type "suggestion/warning/opportunity"
        varchar category "roi_optimization/volume_adjustment/etc"
        varchar title "not null"
        text description "not null"
        integer priority "1=low/2=medium/3=high"
        boolean read "default: false"
        boolean is_applied "default: false"
    }

    user_activities {
        varchar id PK "nanoid"
        varchar user_id FK "references users.user_platform_id"
        varchar activity_type "login/logout/upload/etc"
        varchar page "nullable"
        integer session_duration "minutos"
        jsonb metadata "nullable"
    }

    user_activity {
        varchar id PK "nanoid"
        varchar user_id FK "references users.user_platform_id"
        varchar page "not null"
        varchar action "page_view/feature_use/etc"
        varchar feature "nullable"
        integer duration "segundos"
        jsonb metadata "nullable"
    }

    analytics_daily {
        varchar id PK "nanoid"
        timestamp date "not null"
        varchar user_id FK "nullable"
        integer total_sessions "default: 0"
        integer total_duration "segundos"
        jsonb pages_visited "string[]"
        integer login_count "default: 0"
        integer upload_count "default: 0"
    }

    engagement_metrics {
        varchar id PK "nanoid"
        varchar user_id FK "references users.user_platform_id"
        integer total_sessions "default: 0"
        integer total_time_minutes "default: 0"
        integer streak_days "default: 0"
        integer engagement_score "0-100"
    }

    users ||--|| user_settings : "configuracoes"
    users ||--o{ notifications : "recebe notificacoes"
    users ||--o{ bug_reports : "reporta bugs"
    users ||--o{ custom_groups : "cria grupos"
    custom_groups ||--o{ custom_group_templates : "agrupa templates"
    tournament_templates ||--o{ custom_group_templates : "pertence a grupos"
    users ||--o{ coaching_insights : "recebe insights"
    users ||--o{ user_activities : "tracking basico"
    users ||--o{ user_activity : "tracking avancado"
    users ||--o{ analytics_daily : "resumo diario"
    users ||--o{ engagement_metrics : "metricas engajamento"

    %% ===== DOMINIO: TOURNAMENT SELECTOR (RF-07) =====

    tournament_selector_logs {
        varchar id PK "nanoid — Sprint 1 Tournament Selector"
        varchar user_id FK "references users.user_platform_id, NOT NULL"
        varchar event_type "NOT NULL, check in (view, add_to_grid)"
        varchar tournament_external_id "nullable — preenchido so para add_to_grid"
        integer score "nullable, 0-100, snapshot no momento da acao"
        varchar grade "varchar(1) nullable, S/A/B/C/D"
        varchar confidence "nullable, low/medium/high"
        jsonb metadata "nullable — snapshot filtros + signals (so add_to_grid no MVP)"
        timestamp created_at "defaultNow, NOT NULL"
    }

    users ||--o{ tournament_selector_logs : "log de uso do selector (RF-07)"

    %% Indices recomendados em tournament_selector_logs:
    %%   IDX (user_id, created_at DESC) — consultas de telemetria por jogador
    %%   IDX (event_type, created_at DESC) — agregacoes globais para calibragem futura
    %%   IDX (user_id, event_type, created_at DESC) — funil view -> add_to_grid por jogador

    %% ===== DOMINIO: BANKROLL MANAGEMENT (Sprint 2) =====

    bankroll_snapshots {
        varchar id PK "nanoid — Sprint 2 Bankroll"
        varchar user_id FK "references users.user_platform_id ON DELETE CASCADE, NOT NULL"
        timestamp occurred_at "NOT NULL defaultNow — quando o movimento aconteceu (permite retroativo, nao permite futuro)"
        decimal delta "NOT NULL — USD, assinado (negativo=saque), nunca zero"
        decimal previous_amount "NOT NULL — saldo antes do movimento (auditoria)"
        decimal new_amount "NOT NULL — saldo apos o movimento (auditoria)"
        varchar reason "NOT NULL — enum app-level: initial/deposit/withdrawal/session_result/manual_adjustment"
        text note "nullable — max 500 chars validacao Zod"
        varchar source "NOT NULL default manual — manual/auto_session/auto_import"
        varchar session_id FK "nullable — FK opcional para grind_sessions.id, usado quando source=auto_session (fora do MVP)"
        timestamp created_at "defaultNow — auditoria de quando o row foi inserido"
    }

    users ||--o{ bankroll_snapshots : "registra historico de banca (ADR-017)"
    grind_sessions ||--o{ bankroll_snapshots : "FK opcional — auto_session fora do MVP (Q3)"

    %% Indices recomendados em bankroll_snapshots:
    %%   IDX (user_id, occurred_at DESC) — alvo das queries GET /api/bankroll/history
    %%   IDX (user_id, reason) — queries de summary agrupadas por tipo

    %% Invariantes (ADR-017):
    %%   user_settings.bankroll_amount == ultimo snapshot.new_amount (cache autoritativo)
    %%   snapshot[n+1].previous_amount == snapshot[n].new_amount (detectar drift por clock skew)
    %%   delta != 0 (validacao Zod)
    %%   occurred_at <= now() (validacao Zod, nao permite futuro)
    %%   Transacao: UPDATE user_settings.bankroll_amount + INSERT bankroll_snapshots sao atomicos
    %%
    %% Regras derivadas (ADR-018):
    %%   tolerancia hardcoded BANKROLL_TOLERANCE = 1.5
    %%   softLimit = bankrollAmount * rulePct/100  (warning out_of_bankroll_soft)
    %%   hardLimit = bankrollAmount * rulePct/100 * 1.5  (warning out_of_bankroll + filtrado)

    %% Campos ja existentes em user_settings (Sprint 1, sem alteracao de schema no Sprint 2):
    %%   user_settings.bankroll_amount  decimal nullable — saldo autoritativo em USD
    %%   user_settings.bankroll_rule    varchar default '1pct' — 1pct/2pct/5pct/custom:X
    %%   user_settings.exchange_rates   jsonb — taxas para normalizacao BRL->USD
    %% Quando bankroll_amount = NULL, bankrollFilter no Selector e desabilitado
    %% e response inclui flag bankrollConfigured: false.

    %% ===== DOMINIO: AI COACH (Sprint Coach-1) =====

    chat_sessions {
        varchar id PK "nanoid"
        varchar user_id FK "references users.user_platform_id ON DELETE CASCADE, NOT NULL"
        varchar coach_type "NOT NULL (mental/tournament/technical)"
        varchar status "default: active (active/archived)"
        integer total_tokens "default: 0 — soma cumulativa"
        text title "nullable — gerado apos 2-3 msgs"
        timestamp created_at "defaultNow"
        timestamp updated_at "defaultNow"
    }

    chat_messages {
        varchar id PK "nanoid"
        varchar session_id FK "references chat_sessions.id ON DELETE CASCADE, NOT NULL"
        varchar role "NOT NULL (user/assistant)"
        text content "NOT NULL"
        jsonb metadata "nullable — backup/telemetria livre"
        integer input_tokens "nullable — Sprint Coach-1 RF-01"
        integer output_tokens "nullable — Sprint Coach-1 RF-01"
        integer cache_creation_input_tokens "nullable — Sprint Coach-1 RF-01 (tokens escritos no cache)"
        integer cache_read_input_tokens "nullable — Sprint Coach-1 RF-01 (tokens lidos do cache)"
        varchar model "nullable varchar(64) — ex: claude-sonnet-4-6"
        integer latency_ms "nullable — latencia total stream"
        varchar feedback "nullable varchar(10) — up/down (desnormalizado de message_feedback para queries rapidas)"
        text feedback_comment "nullable — desnormalizado, max 500 via Zod"
        timestamp created_at "defaultNow"
    }

    message_feedback {
        varchar id PK "nanoid — Sprint Coach-1 RF-02"
        varchar message_id FK "references chat_messages.id ON DELETE CASCADE, NOT NULL"
        varchar user_id FK "references users.user_platform_id ON DELETE CASCADE, NOT NULL"
        varchar feedback "NOT NULL varchar(10) CHECK IN (up, down)"
        text comment "nullable, max 500 via Zod"
        timestamp created_at "defaultNow"
    }

    user_ai_profile {
        varchar id PK "nanoid"
        varchar user_id FK "references users.user_platform_id, UNIQUE, NOT NULL"
        varchar coach_type "NOT NULL (mental/tournament/technical) — 1 profile por (user, coach)"
        text content "NOT NULL — perfil compactado para bloco estatico cacheado"
        timestamp last_compacted_at "defaultNow"
        timestamp created_at "defaultNow"
        timestamp updated_at "defaultNow"
    }

    monthly_coach_summaries {
        varchar id PK "nanoid"
        varchar user_id FK "references users.user_platform_id, NOT NULL"
        varchar coach_type "NOT NULL"
        varchar month "NOT NULL YYYY-MM"
        text summary "NOT NULL — resumo gerado por Haiku 4.5"
        integer sessions_count "default: 0"
        integer messages_count "default: 0"
        timestamp created_at "defaultNow"
    }

    users ||--o{ chat_sessions : "inicia conversas com coaches"
    users ||--o{ user_ai_profile : "tem 1 profile por coach (3x)"
    users ||--o{ monthly_coach_summaries : "gera resumos mensais"
    users ||--o{ message_feedback : "da thumbs up/down"
    chat_sessions ||--o{ chat_messages : "contem mensagens"
    chat_messages ||--o{ message_feedback : "recebe feedback (0 ou 1 por usuario)"

    %% Indices recomendados em chat_messages (Sprint Coach-1):
    %%   IDX (session_id, created_at) — idx_chat_messages_session_created
    %%     acelera listagem de historico (ORDER BY created_at ASC) e compactacao mensal
    %%   IDX (role, created_at) — idx_chat_messages_role_created
    %%     para queries de rate limit rolling 24h (WHERE role='user' AND created_at > now()-24h)
    %%
    %% Indices em message_feedback (Sprint Coach-1):
    %%   UNIQUE (message_id, user_id) — uniq_message_feedback_user_message
    %%     garante 1 feedback por (usuario, mensagem); trocar voto exige DELETE + POST
    %%   IDX (message_id) — idx_message_feedback_message
    %%     lookup por mensagem (render de badge)
    %%   IDX (user_id, created_at DESC) — idx_message_feedback_user_created
    %%     historico de feedbacks do proprio usuario
    %%   IDX (feedback, created_at DESC) — para dashboard admin (top downs recentes)
    %%
    %% Regras derivadas (Sprint Coach-1):
    %%   role='user' em chat_messages NAO aceita feedback (400)
    %%   chat_messages.feedback/feedback_comment sao desnormalizacao OPCIONAL:
    %%     fonte de verdade e message_feedback; colunas permitem render rapido sem join
    %%   Rate limit 24h rolling: COUNT chat_messages.role='user' via JOIN chat_sessions.user_id
    %%   Custo por mensagem (USD) =
    %%     (input_tokens*3 + cache_creation_input_tokens*3.75
    %%      + cache_read_input_tokens*0.30 + output_tokens*15) / 1_000_000

    %% ===== DOMINIO: AI COACH TOOLS (Sprint Coach-2A) =====

    coach_actions {
        varchar id PK "nanoid — Sprint Coach-2A"
        varchar user_id FK "references users.id ON DELETE CASCADE, NOT NULL"
        varchar chat_session_id "nullable — FK soft para chat_sessions.id"
        varchar message_id "nullable — id da chat_messages que disparou a tool"
        varchar tool_use_id "nullable — id retornado pela Anthropic Tool Use API"
        varchar tool_name "NOT NULL — match com CoachTool.name (ADR-023)"
        varchar status "NOT NULL — pending/executing/completed/failed/undone"
        jsonb input "nullable — params validados pelo Zod schema da tool"
        jsonb result "nullable — output truncado a 32KB, so com auditLevel=persist (ADR-024 wrapped)"
        text error_message "nullable — preenchido quando status=failed"
        jsonb payload_before "nullable — estado antes da mutacao (Sprint 2B+ undo); null neste sprint"
        boolean requires_confirmation "default: false NOT NULL — sempre false em read tools (Sprint 2A)"
        integer latency_ms "nullable — performance.now() inicio/fim do handler"
        timestamp executed_at "nullable — set pelo runner ao iniciar handler"
        timestamp undone_at "nullable — Sprint 2B+ rollback"
        timestamp created_at "defaultNow NOT NULL"
    }

    users ||--o{ coach_actions : "executa tools via Coach v2 (Sprint Coach-2A)"
    chat_sessions ||--o{ coach_actions : "tools agrupadas por sessao (FK soft)"
    chat_messages ||--o{ coach_actions : "tool calls disparadas em mensagem"

    %% Indices em coach_actions (Sprint Coach-2A):
    %%   IDX (chat_session_id) — idx_coach_actions_session
    %%     agrupar tools de uma conversa (debug + UX historica)
    %%   IDX (user_id, status, created_at DESC) — idx_coach_actions_user_status
    %%     listar tools de um user, filtro por status (telemetria por jogador)
    %%   IDX (tool_name, status, created_at DESC) — idx_coach_actions_tool
    %%     telemetria global por tool (RF-07: tools-metrics endpoint admin)
    %%
    %% Regras derivadas (Sprint Coach-2A):
    %%   ADR-023: name FK soft para CoachTool.name registrado in-memory; nao DB-validated
    %%   ADR-024: result e SEMPRE wrapped {__type:'ToolResult', tool, ok, data} antes de persistir
    %%   ADR-026: max 5 linhas por turn de usuario (toolCallsInTurn cap)
    %%   auditLevel da tool determina se result e persistido:
    %%     'none'    => sem linha
    %%     'log'     => linha com result=null (so input + status + latency)
    %%     'persist' => linha com result truncado a 32KB
    %%   payload_before = null neste sprint (so faz sentido em mutation tools — Sprint 2B+)
    %%   requires_confirmation = false em todas tools deste sprint (read-only)
    %%   chat_session_id FK soft: chat_sessions ja existe (Sprint Coach-1) mas FK nao e enforced
    %%     porque sessions podem ser purgadas independentemente sem afetar audit historico
